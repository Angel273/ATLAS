# Copy with: node scripts/setup-local.mjs (generates unique local secrets).
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
API_INTERNAL_URL=http://127.0.0.1:4000
POSTGRES_PASSWORD=replace-with-local-secret
ATLAS_APP_PASSWORD=replace-with-local-secret
ATLAS_AUTH_PASSWORD=replace-with-local-secret
ADMIN_DATABASE_URL=postgresql://postgres:replace-with-local-secret@127.0.0.1:54329/atlas
DATABASE_URL=postgresql://atlas_app:replace-with-local-secret@127.0.0.1:54329/atlas
AUTH_DATABASE_URL=postgresql://atlas_auth:replace-with-local-secret@127.0.0.1:54329/atlas
REDIS_URL=redis://127.0.0.1:63799
AUTH_ENCRYPTION_KEY=replace-with-64-hex-characters
AUTH_RATE_KEY=replace-with-64-hex-characters
MINIO_ROOT_USER=atlas-local
MINIO_ROOT_PASSWORD=replace-with-local-secret
S3_ENDPOINT=http://127.0.0.1:9009
# Provision an administrator separately with bootstrap:admin.
# Bootstrap inputs are read from ATLAS_ADMIN_EMAIL, ATLAS_ADMIN_PASSWORD,
# ATLAS_ORGANIZATION_NAME; never log them or commit credentials.
